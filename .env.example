# Copier en .env — ne jamais versionner .env
EASYTRADE_API_URL=
EASYTRADE_ENV=local
EASYTRADE_DATA_DIR=./data
EASYTRADE_AS_OF=2026-11-12

# AWS : compte d'atelier du datathon, région us-east-1 (A2). Identifiants des modèles : catalogue Bedrock
# (profil d'inférence, souvent « us.anthropic.… »). Les deux identifiants renseignés → agents sur Bedrock.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Identifiants temporaires de l'atelier (page de l'atelier, « Get AWS CLI credentials »). Ils expirent :
# les remplacer ici quand une commande renvoie `ExpiredToken`. Ne jamais les coller ailleurs.
# Ni l'AWS CLI, ni CDK, ni le backend ne lisent ce fichier seuls : le charger dans le terminal
# (PowerShell, depuis la racine du dépôt) :
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]*)=(.*)$') { Set-Item "env:$($matches[1].Trim())" $matches[2].Trim().Trim('"') } }
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID_FAST=
BEDROCK_MODEL_ID_STRONG=
BEDROCK_GUARDRAIL_ID=

# Sources publiques
SEC_EDGAR_USER_AGENT="EasyTrade Datathon <courriel de contact>"
FRED_API_KEY=

# Sources optionnelles (désactivées par défaut — voir docs/08_CONFORMITE.md)
ENABLE_ALPACA=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
ENABLE_FINNHUB=false
FINNHUB_API_KEY=

# Mobile : ces deux variables ne sont PAS lues depuis ce fichier. Expo lit `mobile/.env` (ignoré par git,
# comme celui-ci) : y copier ces lignes. Après le déploiement (P4), EXPO_PUBLIC_API_URL = sortie
# `EasyTradeApi.ApiUrl` et EXPO_PUBLIC_USE_MOCKS=false.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_USE_MOCKS=true
